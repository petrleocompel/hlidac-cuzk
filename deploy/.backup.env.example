# Separate file: never commit credentials or back up this file into its own repository.
BACKUP_INSTANCE=hlidac-cuzk
# Off-host examples: s3:https://s3.example.com/bucket/database or sftp:backup@host:/backups/database
BACKUP_REPOSITORY=
BACKUP_PASSWORD=
# Separate repository and independent password for instance config + encryption keys.
BACKUP_CONFIG_REPOSITORY=
BACKUP_CONFIG_PASSWORD=
BACKUP_CONFIG_PATHS=/instance-config
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_SCHEDULE=0 2 * * *
BACKUP_TIMEZONE=UTC
# S3 only; restic also supports SFTP/REST repositories with their native configuration.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Restore only: set privately to a NEW empty database before pnpm backup restore <snapshot-id>.
RESTORE_DATABASE_URL=
