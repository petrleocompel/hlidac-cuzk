{
  "name": "hlidac-cuzk",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted watcher for Czech cadastre (ČÚZK) parcels, buildings and proceedings with change notifications",
  "license": "AGPL-3.0-only",
  "author": "Petr Leo Compel",
  "homepage": "https://github.com/petrleocompel/hlidac-cuzk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrleocompel/hlidac-cuzk.git"
  },
  "bugs": {
    "url": "https://github.com/petrleocompel/hlidac-cuzk/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --import ./instrument.server.mjs --import tsx scripts/start.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "cron": "tsx scripts/cron.ts",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "notifications:encrypt": "tsx scripts/encrypt-notifications.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "doctor": "tsx scripts/doctor.ts",
    "env:init": "tsx scripts/init-env.ts",
    "backup": "tsx scripts/backup.ts",
    "retention": "tsx scripts/retention.ts",
    "account:recover": "tsx scripts/recover-password.ts",
    "test:backup": "vitest run --config vitest.backup.config.ts"
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.7",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/tanstackstart-react": "^11.4.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "ol": "10.10.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-cli": "^1.167.40",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "jsdom": "30.1.1",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
