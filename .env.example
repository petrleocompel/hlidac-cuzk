DATABASE_URL=postgresql://hlidac:change-me@127.0.0.1:5432/hlidac_cuzk
BETTER_AUTH_SECRET=replace-with-32-char-minimum-secret-value-xxxxxxxxxxxx
BETTER_AUTH_URL=http://127.0.0.1:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Registration: private (admin-created accounts), invite, open
REGISTRATION_MODE=private
# SSO creation is independent: existing, invite (verified email), open
SSO_REGISTRATION_MODE=existing
AUTH_MODE=hybrid
# Enable only behind a proxy that replaces forwarding headers and blocks direct access.
AUTH_TRUST_PROXY_HEADERS=false
AUTH_TRUSTED_PROXIES=
ADMIN_NAME=Petr
CUZK_API_KEY=
CUZK_API_BASE_URL=https://api-kn.cuzk.gov.cz
# Shared PostgreSQL budget is fixed at 500 attempts per Europe/Prague day.
CUZK_REQUEST_TIMEOUT_MS=15000
CUZK_MIN_REQUEST_INTERVAL_MS=1000
MAX_WATCHES_PER_USER=100
# Optional /api/metrics bearer token (at least 32 random characters); empty disables.
METRICS_BEARER_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
GOTIFY_URL=
GOTIFY_TOKEN=

# Optional one-shot SSO bootstrap (never overwrites existing providerId)
SSO_BOOTSTRAP_ENABLED=false
SSO_BOOTSTRAP_PROVIDER_ID=authentik
SSO_BOOTSTRAP_ISSUER=
SSO_BOOTSTRAP_CLIENT_ID=
SSO_BOOTSTRAP_CLIENT_SECRET=
SSO_BOOTSTRAP_DOMAIN=
SSO_BOOTSTRAP_LABEL=Authentik

# Notification secrets: generate with openssl rand -base64 32; back up separately.
NOTIFICATION_ENCRYPTION_KEY=
# Only during key rotation; remove after notifications:encrypt succeeds.
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY=
# Initial Gotify whitelist (comma-separated exact base URLs); empty permits all HTTP/HTTPS including LAN.
# Admin → Notification rules overrides this value after the first save.
GOTIFY_ALLOWED_URLS=
